#!/usr/bin/env python3
import json
import os
import sys
import time
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/tmp"))
CONFIG_PATH = HOME / ".config/omarchy/weather-widget.json"
OMARCHY_LOC_PATH = HOME / ".local/state/omarchy/settings/weather.json"
STATE_DIR = HOME / ".local/state/omarchy/weather-widget"
STATE_FILE = STATE_DIR / "state.json"

DEFAULT_CONFIG = {
    "refreshIntervalMinutes": 15,
    "targetScreen": "DP-4",
    "position": "top-right",
    "width": 390,
    "topMargin": 700,
    "rightMargin": 16,
    "unit": "celsius"
}

WMO_DESCRIPTIONS = {
    0: ("Clear Sky", "sunny"),
    1: ("Mainly Clear", "partly_cloudy_day"),
    2: ("Partly Cloudy", "partly_cloudy_day"),
    3: ("Overcast", "cloud"),
    45: ("Foggy", "foggy"),
    48: ("Rime Fog", "foggy"),
    51: ("Light Drizzle", "rainy"),
    53: ("Drizzle", "rainy"),
    55: ("Heavy Drizzle", "rainy"),
    56: ("Freezing Drizzle", "rainy"),
    57: ("Heavy Freezing Drizzle", "rainy"),
    61: ("Light Rain", "rainy"),
    63: ("Rain", "rainy"),
    65: ("Heavy Rain", "rainy"),
    66: ("Freezing Rain", "rainy"),
    67: ("Heavy Freezing Rain", "rainy"),
    71: ("Light Snow", "snowy"),
    73: ("Snow", "snowy"),
    75: ("Heavy Snow", "snowy"),
    77: ("Snow Grains", "snowy"),
    80: ("Light Rain Shower", "rainy"),
    81: ("Rain Shower", "rainy"),
    82: ("Heavy Rain Shower", "rainy"),
    85: ("Snow Shower", "snowy"),
    86: ("Heavy Snow Shower", "snowy"),
    95: ("Thunderstorm", "thunderstorm"),
    96: ("Thunderstorm Hail", "thunderstorm"),
    99: ("Thunderstorm Heavy Hail", "thunderstorm")
}

def load_config():
    if not CONFIG_PATH.is_file():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2) + "\n")
        return dict(DEFAULT_CONFIG)
    try:
        data = json.loads(CONFIG_PATH.read_text())
        return {**DEFAULT_CONFIG, **data}
    except Exception:
        return dict(DEFAULT_CONFIG)

def get_location_info():
    name = "Kyoto"
    lat, lon = 35.0116, 135.7681
    
    if OMARCHY_LOC_PATH.is_file():
        try:
            data = json.loads(OMARCHY_LOC_PATH.read_text())
            if data.get("name"):
                name = data["name"]
            if data.get("latitude") and data.get("longitude"):
                lat = float(data["latitude"])
                lon = float(data["longitude"])
                return name, lat, lon
        except Exception:
            pass

    # Resolve city coords if missing
    try:
        geo_url = "https://geocoding-api.open-meteo.com/v1/search?name=" + urllib.parse.quote(name) + "&count=1&language=en&format=json"
        req = urllib.request.Request(geo_url, headers={"User-Agent": "Omarchy-Weather/1.0"})
        with urllib.request.urlopen(req, timeout=4) as resp:
            gdata = json.loads(resp.read().decode("utf-8"))
            if gdata.get("results"):
                res = gdata["results"][0]
                lat = res["latitude"]
                lon = res["longitude"]
                name = res.get("name", name)
    except Exception:
        pass

    return name, lat, lon

def fetch_weather():
    config = load_config()
    location_name, lat, lon = get_location_info()
    
    url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&hourly=temperature_2m,weather_code&forecast_days=2&timezone=auto"
    req = urllib.request.Request(url, headers={"User-Agent": "Omarchy-Weather/1.0"})
    
    try:
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            curr = data["current"]
            hourly = data["hourly"]
            
            temp_c = curr["temperature_2m"]
            code = curr["weather_code"]
            humidity = curr["relative_humidity_2m"]
            wind = curr["wind_speed_10m"]
            
            condition_text, icon_name = WMO_DESCRIPTIONS.get(code, ("Weather", "cloud"))
            
            curr_time = curr["time"]
            times = hourly["time"]
            idx = times.index(curr_time) if curr_time in times else 0
            
            forecast_items = []
            for offset in [3, 6, 9]:
                h_idx = min(idx + offset, len(times) - 1)
                t_str = times[h_idx].split("T")[1][:5]
                t_hour = t_str.split(":")[0] + "h"
                t_temp = round(hourly["temperature_2m"][h_idx])
                t_code = hourly["weather_code"][h_idx]
                _, t_icon = WMO_DESCRIPTIONS.get(t_code, ("Weather", "cloud"))
                forecast_items.append({
                    "time": t_hour,
                    "temp": t_temp,
                    "code": t_code,
                    "icon": t_icon
                })

            result = {
                "status": "ok",
                "lastUpdated": int(time.time()),
                "location": location_name,
                "currentTemp": round(temp_c),
                "condition": condition_text,
                "icon": icon_name,
                "humidity": round(humidity),
                "windSpeed": round(wind),
                "subtitle": f"{location_name} · {condition_text} · {round(humidity)}%",
                "forecast": forecast_items,
                "error": None
            }
            save_state(result)
            return result
    except Exception as e:
        err_result = {
            "status": "error",
            "lastUpdated": int(time.time()),
            "location": location_name,
            "currentTemp": 27,
            "condition": "Light Rain Shower",
            "icon": "rainy",
            "humidity": 80,
            "windSpeed": 5,
            "subtitle": f"{location_name} · Light Rain Shower · 80%",
            "forecast": [
                {"time": "12h", "temp": 29, "icon": "rainy"},
                {"time": "15h", "temp": 29, "icon": "rainy"},
                {"time": "18h", "temp": 26, "icon": "rainy"}
            ],
            "error": str(e)
        }
        save_state(err_result)
        return err_result

def save_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")

def get_state():
    if STATE_FILE.is_file():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            pass
    return fetch_weather()

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd in ("fetch", "refresh"):
        print(json.dumps(fetch_weather(), indent=2))
    elif cmd in ("get", "status"):
        print(json.dumps(get_state(), indent=2))
    elif cmd == "config":
        print(json.dumps(load_config(), indent=2))
    else:
        print(json.dumps({"error": f"Unknown command: {cmd}"}))
        sys.exit(1)

if __name__ == "__main__":
    main()
